// Infrastructure only: scheduler, ceilings, mounts, and cache locations.
params {
    config_profile_name        = 'Institutional SLURM + Apptainer'
    config_profile_description = 'Shared filesystem; databases and container cache are immutable inputs'
}

process {
    executor = 'slurm'
    queue = 'compute'
    resourceLimits = [cpus: 32, memory: 220.GB, time: 72.h]
    clusterOptions = '--account=REPLACE_WITH_ACCOUNT'
}

executor {
    queueSize = 50
    submitRateLimit = '10 sec'
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = '/shared/containers/nf-core-mag-5.5.0'
    runOptions = '--bind /shared/db,/scratch'
}

docker.enabled = false
singularity.enabled = false
conda.enabled = false
